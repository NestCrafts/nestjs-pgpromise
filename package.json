{
  "name": "nestjs-pgpromise",
  "version": "2.5.2",
  "description": "pg-promise module for nestjs",
  "keywords": [
    "nestjs",
    "pg",
    "postgres"
  ],
  "license": "MIT",
  "author": "Rubin Bhandari",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx rimraf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check **/*.ts",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "coveralls": "pnpm coverage --coverageReporters=text-lcov | coveralls"
  },
  "dependencies": {
    "pg-promise": "^12.7.1"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/testing": "^11.2.3",
    "@rubiin/tsconfig": "^2.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@types/supertest": "^7.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.0.0",
    "@nestjs/core": ">=11.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,yaml,yml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
